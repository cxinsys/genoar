.next/
# Local development overlay for compose. Copied from the .example beside it
# and kept off the deployments, which serve the production build.
docker-compose.override.yml

# One machine's dataset settings and schemas, like the overlay above: the
# names and paths in them belong to a deployment, not the repo.
datasets.env
mariadb-init/*.sql
