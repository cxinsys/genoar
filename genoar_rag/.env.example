# GENOAR RAG Web UI environment settings
# Copy this file to .env before use: cp .env.example .env

# Database backend: mysql (default, a MySQL/MariaDB server) or sqlite (a file; for
# development and testing, and the automatic fallback if MariaDB is unreachable)
DB_BACKEND=mysql

# Path to the DB file when using SQLite (absolute or relative to the host)
DB_FILE=./data/sra_hybrid.db

# For MariaDB (DB_BACKEND=mysql). Start the mariadb service with:
#   docker compose --profile mysql up
# Migrate existing data:  python backend/scripts/migrate_sqlite_to_mysql.py --drop
#
# Both passwords are left empty on purpose. A value printed here would not be a
# placeholder, it would be the password: copying this file would be enough to
# start a reachable database whose credentials are in the repository. Compose
# passes them through with no default of its own, and the image refuses to
# initialise on an empty one, so the mysql profile stays down until you fill
# both in. Nothing generates them for you.
DB_HOST=mariadb
DB_PORT=3306
DB_USER=genoar
# Required, no default. Fill in before starting the mysql profile.
DB_PASSWORD=
DB_NAME=genoar
# Required, no default. Fill in before starting the mysql profile.
DB_ROOT_PASSWORD=

# Port settings (omit to keep the defaults). The backend port is bound to
# 127.0.0.1 only; the browser reaches the API through the frontend.
BACKEND_PORT=8001
FRONTEND_PORT=3005

# Semantic search (routed per species): human=SapBERT, mouse=all-MiniLM-L6-v2
# Each species has its own embedding model and FAISS index; the organism filter
# decides which one a query goes to.
# The faiss_index.bin that shipped in the repo was built with PubMedBERT and does
# not match either model below. You have to build both indexes yourself before
# semantic search will work:
#   python backend/scripts/build_faiss_index.py --db ./data/sra_hybrid.db \
#     --model cambridgeltl/SapBERT-from-PubMedBERT-fulltext --organism "Homo sapiens" \
#     --out-index ./data/faiss_human.bin --out-mapping ./data/run_mapping_human.json
#   python backend/scripts/build_faiss_index.py --db ./data/sra_hybrid.db \
#     --model sentence-transformers/all-MiniLM-L6-v2 --organism "Mus musculus" \
#     --out-index ./data/faiss_mouse.bin --out-mapping ./data/run_mapping_mouse.json
SEMANTIC_SEARCH_ENABLED=true

# Human: SapBERT (as settled in the paper), 768 dimensions, 3,114 samples.
HUMAN_EMBEDDING_MODEL_NAME=cambridgeltl/SapBERT-from-PubMedBERT-fulltext
HUMAN_FAISS_INDEX=./data/faiss_human.bin
HUMAN_RUN_MAPPING=./data/run_mapping_human.json

# Mouse: all-MiniLM-L6-v2 (the model the paper evaluated), 384 dimensions, 3,085
# samples. The paper writes this model as "MiniLLM", but the model actually
# evaluated was all-MiniLM-L6-v2.
MOUSE_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MOUSE_FAISS_INDEX=
MOUSE_RUN_MAPPING=

# Turning off a single species: set that species' two container paths to an
# **explicitly empty value** as shown below and semantic search is disabled for
# that species only (keyword search and the other species are untouched). Emptying
# only one of the two is treated as a configuration mistake and the service refuses
# to start. These are different variables from the MOUSE_FAISS_INDEX family above
# (which are host file locations, used for mounting) — delete these lines entirely
# and the default paths come back, re-enabling the species. Uncomment both lines
# for a deployment made before the mouse index is ready:
# MOUSE_FAISS_INDEX_PATH=
# MOUSE_RUN_MAPPING_PATH=

# Data access (works without an API key)
# We do not serve the raw reads; we link out to the archive's record page instead.
# The data was deposited by its authors under the archive's terms of use, so GENOAR
# has no right to redistribute it, and the files run to tens of gigabytes anyway.
# The record page is also the better destination: it carries the study, the terms,
# and the available formats all in one place.
# Runs that have a GSM recorded link to GEO; everything else links to SRA.
# GEO_RECORD_URL_TEMPLATE=https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc={accession}
# SRA_RECORD_URL_TEMPLATE=https://trace.ncbi.nlm.nih.gov/Traces/?run={run_id}

# Where the Cell Ranger outputs (HDF5) live. Point this at the pipeline's success
# directory. Stage 3 lays them out as <dir>/<SRR>/cellranger_output/outs/, so
# whether the file is actually there is exactly what "processed" means — no separate
# list of processed runs is needed.
# Leave empty to disable downloading processed results.
#
# If you ran Stage 3 through the Makefile, this is ./results/success at the project root.
PROCESSED_RESULTS=../results/success

# Only needed when the outputs are NOT in Stage 3 layout (`<RUN>/cellranger_output/outs/`).
# A comma-separated list of extra path patterns to search for a run under the
# directory above; every pattern must contain `{run_id}`. The Stage 3 layout is
# always searched as well.
# Example: a deployment that keeps outputs from different runs per species in one tree
# PROCESSED_RESULTS_LAYOUTS=HS/{run_id}/cellranger_output/outs,MM/{run_id}
PROCESSED_RESULTS_LAYOUTS=

# Stage 3 writes a receipt beside each run's output recording which run produced
# it and whether that run verified it. Output whose receipt records an adoption,
# and output whose receipt cannot be read, are withheld whatever this is set to.
# This decides output with no receipt at all, which is what results produced
# before receipts existed look like. false serves it. true withholds it.
# PROCESSED_RESULTS_REQUIRE_RECEIPT=false

# Only needed when the files are served from another host (object storage, say).
# Ignored if PROCESSED_RESULTS is set.
# Example: https://data.example.org/genoar/{run_id}/filtered_feature_bc_matrix.h5
PROCESSED_H5_URL_TEMPLATE=

# Refuse to load an index that was built with a different model than the one
# configured (this is what stops it failing silently).
# Set to false to use a legacy (PubMedBERT) index that has no sidecar.
REQUIRE_INDEX_MODEL_MATCH=true

# ── Datasets ──────────────────────────────────────────────────────────────
# The bodies of data this deployment serves. Left empty (the default), it serves
# the single one built from the settings above and no dataset appears in the URL —
# exactly the existing single-deployment behaviour.
#
# List several names and the dashboard and search can each use a different corpus.
# The first name is the primary and reads the top-level settings above. Every name
# after the first **must** declare its own DB (schema or file) and its per-species
# indexes in datasets.env — leave any of them out and the service refuses to start
# (this is what stops the primary data being served under a second name by accident).
# The DATASET_<NAME>_* variables go in datasets.env, not in this file: Compose does
# not pass .env through to the container.
# Add file mounts in docker-compose.override.yml and MariaDB schema creation in
# mariadb-init/. See the comments in each of those files.
DATASETS=

# The dataset the dashboard describes (a frontend build argument; empty means the
# same one search uses).
DASHBOARD_DATASET=
