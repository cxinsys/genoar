# GENOAR Pipeline Configuration
# Copy to .env and adjust: cp .env.example .env
#
# Both Docker Compose and the Makefile read .env, so keep every line a plain
# KEY=value and every comment a line of its own. Leave values unquoted; Compose
# strips quotes, Make does not. Compose also strips a comment written after a
# value, and Make does not: it keeps everything up to the #, trailing spaces
# included, so MODE=complete  # mode would set MODE to "complete  ".
# Anything set on the command line (make run PAGES=4) wins over this file.
#
# COMPOSE_PROJECT_NAME is not listed below. It names this run's Compose project,
# and with it the run's container, network and result directories. The default
# project, genoar, writes crawl_output/, first_pass_output/, logs/ and
# workflow_output/ in the checkout root. Any other name writes the same four
# under projects/<name>/. Set it here to move every run of this checkout. Set it
# per command to run a second pipeline alongside the first:
#   make run COMPOSE_PROJECT_NAME=second
# make status, make logs and make clean need the same name to report that run.
# Stage 3, run by make run-stage3, is not scoped this way.

# ---- Stage 1: Crawler ----
# Number of GEO pages to crawl.
PAGES=100
# Parallel worker count. 1 matches the Makefile and Compose defaults; this file
# wins over both, so raising it here raises it for `make run` too.
WORKERS=1
# Chrome headless mode.
SELENIUM_HEADLESS=true

# ---- Stage 2 -> Stage 3 bridge (make fetch-sra) ----
# Filtered Stage 2 tables. raw-stage1 is opt-in.
SRA_SOURCE=stage2
# SRA files to download, or 'all' (they are large).
MAX_SAMPLES=2
# Parallel downloads.
MAX_CONCURRENT=4

# ---- Execution ----
# complete | crawl | analyze | test
MODE=complete
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- Docker Resources ----
# Max CPU cores.
CPU_LIMIT=4
# Max memory.
MEMORY_LIMIT=8G
# Reserved CPU cores.
CPU_RESERVE=2
# Reserved memory.
MEMORY_RESERVE=4G
