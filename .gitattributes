# Normalize line endings to prevent CRLF from breaking Linux containers.
# Shell scripts and Dockerfiles MUST be LF, otherwise container entrypoints
# fail with: /usr/bin/env: 'bash\r': No such file or directory
* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.smk       text eol=lf
Dockerfile  text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf

# Binary assets; never normalize
*.png  binary
*.jpg  binary
*.gz   binary
*.bin  binary
*.db   binary
*.pdf  binary
